{
    "name": "kariricode/router",
    "description": "Protocol-agnostic routing engine for PHP 8.4+: static routes in a hash map, parameterized routes in chunked PCRE with MARK verbs, typed parameter constraints, attribute and array route loading, URL generation and an OPcache-friendly compiled route table.",
    "keywords": [
        "kariricode",
        "router",
        "routing",
        "url-generator",
        "protocol-agnostic",
        "arfa",
        "php84"
    ],
    "homepage": "https://kariricode.org/",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Walmir Silva",
            "email": "walmir.silva@kariricode.org"
        }
    ],
    "require": {
        "php": "^8.4",
        "kariricode/exception": "^2.0"
    },
    "suggest": {
        "psr/event-dispatcher": "For Integration\\EventDispatcherBridge, which publishes match outcomes as PSR-14 events",
        "psr/simple-cache": "For Integration\\SimpleCacheStore, which keeps the compiled route table in a PSR-16 cache"
    },
    "autoload": {
        "psr-4": {
            "KaririCode\\Router\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KaririCode\\Router\\Tests\\": "tests/"
        }
    },
    "support": {
        "issues": "https://github.com/KaririCode-PHP/router/issues",
        "source": "https://github.com/KaririCode-PHP/router"
    },
    "extra": {
        "kariricode": {
            "arfa": {
                "version": "1.3",
                "level": 1
            },
            "asvs": {
                "version": "5.0",
                "level": 1
            },
            "spec": "4.3.3",
            "error-code-range": "RO 5000–5099"
        },
        "branch-alias": {
            "dev-main": "4.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "kcode test",
        "test-unit": "kcode test --testsuite=unit",
        "test-integration": "kcode test --testsuite=integration",
        "test-conformance": "kcode test --testsuite=conformance",
        "phpstan": "kcode run phpstan analyse --no-progress --memory-limit=1G",
        "psalm": "kcode run psalm --no-cache",
        "complexity": "@php tools/complexity.php src",
        "mutation": "kcode run infection --threads=max --no-progress --show-mutations",
        "security": [
            "@composer audit --locked",
            "@composer audit --locked --working-dir=.kcode",
            "@php tools/secret-scan.php"
        ],
        "sbom": "@php tools/sbom.php sbom.cdx.json",
        "cs-check": "kcode cs:fix --check",
        "cs-fix": "kcode cs:fix",
        "check": [
            "@cs-check",
            "@phpstan",
            "@psalm",
            "@complexity",
            "@test",
            "@mutation"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
